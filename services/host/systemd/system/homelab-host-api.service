# /etc/systemd/system/homelab-host-api.service
# Template: values substituted from .env by setup.py
# User/Group are numeric PUID/PGID (names like Group=username fail when that group does not exist).

[Unit]
Description=Homelab Host API Node.js Server
After=network.target

[Service]
User=${PUID}
Group=${PGID}
Environment=PROJECT_ROOT=${PROJECT_ROOT}
WorkingDirectory=${PROJECT_ROOT}/services/dashboard/host-api
ExecStart=${PROJECT_ROOT}/services/dashboard/host-api/node_modules/.bin/tsx server.ts
Restart=always
RestartSec=3
SyslogIdentifier=homelab-api

[Install]
WantedBy=multi-user.target
