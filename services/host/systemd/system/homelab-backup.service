# /etc/systemd/system/homelab-backup.service
# Template: values substituted from .env (and PYTHON) by setup.py

[Unit]
Description=Homelab Restic cloud backup (via setup.py)
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=${PROJECT_ROOT}
ExecStart=${PYTHON} ${PROJECT_ROOT}/setup.py backup --auto
User=root
