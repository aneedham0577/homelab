# Generated by headscale/setup.py — edit the template, not volumes/config/config.yaml.
server_url: https://${HEADSCALE_WEB_HOSTNAME}
listen_addr: 0.0.0.0:8080
metrics_listen_addr: 127.0.0.1:9090

# Traefik sits on the Docker bridge; honour X-Forwarded-* only from that subnet.
trusted_proxies:
  - ${DOCKER_SUBNET}

noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: ${HEADSCALE_IPV4_PREFIX}
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

# Self-hosted DERP only — no reliance on Tailscale's public relays.
# DERP-over-HTTPS is served on server_url (via Traefik) and STUN on 3478/udp
# (published by the container, forwarded from the router). Direct peer paths
# are preferred; DERP is used for rendezvous and as a fallback.
derp:
  server:
    enabled: true
    region_id: 999
    region_code: "homelab"
    region_name: "Homelab DERP"
    stun_listen_addr: "0.0.0.0:3478"
    # Persisted alongside the DB so the DERP identity survives restarts.
    private_key_path: /var/lib/headscale/derp_server_private.key
    automatically_add_embedded_derp_region: true
    # Set to false to prevent mobile handover stalls between Wi-Fi and cellular.
    verify_clients: false
  # Empty public map — the embedded region above is the only relay.
  urls: []
  paths: []
  auto_update_enabled: false
  update_frequency: 24h

database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true

# TLS is terminated by Traefik.
tls_cert_path: ""
tls_key_path: ""

log:
  level: info
  format: text

policy:
  mode: file
  path: ""

dns:
  magic_dns: true
  # Must differ from the Headscale server_url hostname domain.
  base_domain: ${HEADSCALE_BASE_DOMAIN}
  override_local_dns: true
  nameservers:
    global:
      - ${HOMELAB_IP_ADDRESS}
    split:
      ${HOMELAB_HOSTNAME}:
        - ${HOMELAB_IP_ADDRESS}
      ${DNS_DOMAIN}:
        - ${HOMELAB_IP_ADDRESS}
  search_domains:
    - ${HOMELAB_HOSTNAME}
    - ${DNS_DOMAIN}
  extra_records:
    - name: ${HOMELAB_HOSTNAME}
      type: A
      value: ${HOMELAB_IP_ADDRESS}
    - name: "*.${HOMELAB_HOSTNAME}"
      type: A
      value: ${HOMELAB_IP_ADDRESS}

unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"

oidc:
  # Restart if OIDC is unavailable rather than falling back to CLI register.
  only_start_if_oidc_is_available: true
  issuer: https://${AUTHENTIK_SERVICE_NAME}.${HOMELAB_HOSTNAME}/application/o/headscale/
  client_id: headscale
  client_secret_path: /run/secrets/headscale_oidc_secret
  scope:
    - openid
    - profile
    - email
    - groups
    - offline_access
  email_verified_required: true
  # Match Authentik group names from the custom "groups" scope mapping.
  allowed_groups:
    - homelab-users
    - homelab-admins
  pkce:
    enabled: true
    method: S256

logtail:
  enabled: false

taildrop:
  enabled: true

auto_update:
  enabled: false
